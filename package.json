{
	"name": "matpris",
	"private": true,
	"version": "0.1.4",
	"type": "module",
	"scripts": {
		"dev": "cargo build -p matpris-server && concurrently -k -n api,web \"cargo run -q -p matpris-server\" \"vite dev\"",
		"dev:web": "vite dev",
		"server": "cargo run -p matpris-server",
		"build": "vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"app": "tauri dev",
		"app:build": "tauri build",
		"android": "tauri android dev",
		"android:build": "tauri android build",
		"ios": "tauri ios dev",
		"bump": "npm version --no-git-tag-version",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "cargo test --workspace --exclude matpris",
		"stores:lidl": "node scripts/build-lidl-stores.mjs",
		"stores:axfood": "node scripts/build-axfood-stores.mjs",
		"stores:ica": "node scripts/ica-stores.mjs",
		"catalogue:ica": "node scripts/ica-catalogue.mjs",
		"warm:ica": "node scripts/ica-warm.mjs",
		"mapkit:token": "node scripts/mapkit-token.mjs",
		"record:ica": "node scripts/ica-record.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tauri-apps/cli": "2.12.4",
		"@types/apple-mapkit-js-browser": "^5.78.1",
		"@types/node": "^26.6.6",
		"concurrently": "^10.0.7",
		"html-to-image": "^1.11.13",
		"playwright": "^1.64.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@tauri-apps/api": "2.12.4",
		"@tauri-apps/plugin-geolocation": "^2.5.0"
	}
}
