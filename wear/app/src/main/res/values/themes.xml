<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Matpris" parent="android:Theme.DeviceDefault">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- The icon on black while the app starts, then the app's own theme. -->
    <style name="Theme.Matpris.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Matpris</item>
    </style>
</resources>
