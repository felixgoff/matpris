<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the iPhone app's Info.plist by the Tauri CLI (the way Info.plist is for
	     the Mac). "Use my location": the map asks WKWebView, WKWebView asks iOS, and without
	     this text iOS says no without asking the person. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Matpris finds the grocery stores around you.</string>
	<!-- Only standard HTTPS: answers App Store Connect's export-compliance question, so
	     TestFlight builds don't wait for it to be answered by hand. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
