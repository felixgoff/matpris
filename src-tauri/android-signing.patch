+                keyAlias = signingValue("ANDROID_KEY_ALIAS", "keyAlias")
+                // A PKCS12 keystore (keytool's default) has one password for both.
+                keyPassword = signingValue("ANDROID_KEY_PASSWORD", "keyPassword") ?: storePassword
+            }
+        }
+    }
