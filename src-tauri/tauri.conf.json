{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Matpris",
	"version": "../package.json",
	"identifier": "se.matpris.matpris",
	"build": {
		"beforeDevCommand": "bun run dev:web",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Lifestyle",
		"shortDescription": "Grocery prices from the stores around you",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"minimumSystemVersion": "14.0",
			"infoPlist": "Info.plist"
		},
		"iOS": {
			"minimumSystemVersion": "16.0",
			"developmentTeam": "JWR5UX55S5"
		},
		"android": {
			"minSdkVersion": 26
		}
	}
}
